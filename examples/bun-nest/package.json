{
  "name": "bun-node-examples-bun-nest",
  "type": "module",
  "version": "0.0.0",
  "private": true,
  "description": "Runnable, commented examples for @kingsleyweb/bun-nest: NestJS on Bun with the HTTP adapter, file upload interceptors and the WebSocket adapter",
  "scripts": {
    "all": "bun run-all.ts",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "gen:client": "bun-client generate --module 12-typed-client/helpers/app.ts --out 12-typed-client/helpers/api.gen.ts --zod 12-typed-client/helpers/api.zod.gen.ts",
    "check:client": "bun-client generate --module 12-typed-client/helpers/app.ts --out 12-typed-client/helpers/api.gen.ts --zod 12-typed-client/helpers/api.zod.gen.ts --check"
  },
  "devDependencies": {
    "@nestjs/swagger": "12.0.4"
  }
}
