{
  // The bun-security examples are an unpublished project of their own,
  // checked by `bun scripts/typecheck.ts`. They import `@kingsleyweb/bun-security`
  // (and bun-common, bun-cache, bun-nest and NestJS) by package name, as a
  // consumer would, resolved through the root `node_modules`. The legacy
  // decorator options NestJS needs come from `tsconfig.base.json`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "typeRoots": ["../../node_modules/@types"]
  },
  "include": ["./**/*.ts"],
  "exclude": ["node_modules"]
}
