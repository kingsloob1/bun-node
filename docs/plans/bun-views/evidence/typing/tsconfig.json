{
  // The typed-props spike only: experimentalDecorators as bun-nest uses them.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["*.tsx", "*.ts"]
}
