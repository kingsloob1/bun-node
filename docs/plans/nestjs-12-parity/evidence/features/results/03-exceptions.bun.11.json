        "content-type": "application/json;charset=utf-8"
      },
      "body": "{\"statusCode\":413,\"message\":\"Request body exceeds the maximum allowed size of 1024 bytes (received 4008 bytes)\"}"
    },
    "badEncoding": {
      "status": 415,
      "headers": {
        "content-type": "application/json;charset=utf-8"
      },
      "body": "{\"statusCode\":415,\"message\":\"unsupported content encoding \\\"br-nope\\\"\"}"
    },
