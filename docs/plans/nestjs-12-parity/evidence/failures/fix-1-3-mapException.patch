+  /**
+   * Maps an error raised outside a route's own exception zone (a body the
+   * adapter refused, say) before Nest's exception filters see it — the same
+   * mapping as `@nestjs/platform-express`: a `SyntaxError` (unparsable JSON)
+   * or `URIError` (bad percent-encoding) becomes a `BadRequestException`
+   * with its message; anything else is returned as is.
+   *
+   * Nest 12 calls this from its exception layer (nestjs/nest #15075, which
+   * moved the mapping out of `RoutesResolver.mapExternalException` into each
+   * adapter). Nest 11 never calls it: its core maps these two itself.
+   */
+  public mapException(error: unknown): unknown {
+    if (error instanceof SyntaxError || error instanceof URIError) {
+      return new BadRequestException(error.message);
+    }
+    return error;
+  }
