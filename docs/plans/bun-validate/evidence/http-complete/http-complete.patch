+ * A contract declares, per status code, the response headers, the
+ * `Set-Cookie`s and the body by media type. `createResponseGate` turns one into
+ * the per-request {@link BunResponseGate} that `BunResponse` consults at its
+ * single commit point (the private `response` setter, which every producer —
+ * `json`, `send` of any body, `redirect`, `sendFile`, a stream's first
+ * `write` — passes through) and, for a stream, at every chunk.
+ *
+ * A minimal local runner; the shared core (`validateStandard`) is another
+ * spike's subject (evidence/contract-core/).
+ */
+import type {
+  BunResponse,
+  BunResponseChunk,
+  BunResponseGate,
+  GateCommit,
+  GateVerdict,
+} from "./BunResponse";
+import type { Logger } from "./logging";
+import type { StandardSchemaV1 } from "./types/standardSchema";
+
+/** `"off"`: no checks; `"warn"`: log and send; `"error"`: fail the response. */
+export type ResponseValidationMode = "off" | "warn" | "error";
+
+/** A streamed body checked chunk by chunk (each `write()`, each stream chunk). */
+export interface StreamChunks<S extends StandardSchemaV1 = StandardSchemaV1> {
+  /** Discriminant. */
+  readonly kind: "chunks";
+  /** The schema every chunk must pass: a `string`, or a `Uint8Array` for bytes. */
+  readonly chunk: S;
+}
+
+/** A `text/event-stream` body checked event by event, by event name. */
+export interface SseEvents<
+  E extends Record<string, StandardSchemaV1 | null> = Record<string, StandardSchemaV1 | null>,
+> {
+  /** Discriminant. */
+  readonly kind: "sse";
+  /** Event name (`message` when the event has no `event:` line) to its `data` schema; `null`: no data. */
+  readonly events: E;
+}
+
+/** A media type declared without reading its content (a file, an image). */
+export interface OpaqueBody {
+  /** Discriminant. */
+  readonly kind: "opaque";
+}
+
+/** What one media type of a status may carry. `null`: an empty body. */
+export type ContentSpec =
+  | StandardSchemaV1
+  | null
+  | StreamChunks
+  | SseEvents
+  | OpaqueBody;
+
+/** The full form of one status's contract. */
+export interface ResponseSpecObject {
+  /** The response headers, as an object of lower-case names (`set-cookie` excluded). */
+  headers?: StandardSchemaV1;
+  /** The `Set-Cookie`s, as `{ [name]: { value, httpOnly, secure, sameSite?, path?, domain?, maxAge?, expires?, partitioned } }`. */
+  cookies?: StandardSchemaV1;
+  /** The body by media type (`type/*` and `*\/*` match as fallbacks); `null`: no body. Omitted: body unchecked. */
+  content?: Readonly<Record<string, ContentSpec>> | null;
+}
+
+/** One status: a schema (shorthand for a JSON body), `null` (no body), or the full form. */
+export type ResponseSpec = StandardSchemaV1 | null | ResponseSpecObject;
+
+/** The declared responses, by status code. */
+export type ResponseSchemas = Readonly<Record<number, ResponseSpec>>;
+
+/** Declares a body checked per chunk. */
+export function chunks<S extends StandardSchemaV1>(chunk: S): StreamChunks<S> {
+  return { kind: "chunks", chunk };
+}
+
+/** Declares a server-sent events body checked per event. */
+export function sse<const E extends Record<string, StandardSchemaV1 | null>>(
+  events: E,
+): SseEvents<E> {
+  return { kind: "sse", events };
+}
+
+/** Declares a media type whose content is not read. */
+export function opaque(): OpaqueBody {
+  return { kind: "opaque" };
+}
+
+/** Which part of a response an issue is about. */
+export type ResponsePart = "status" | "headers" | "cookies" | "body" | "chunk" | "event";
+
+/** One response mismatch. */
+export interface ResponseIssue {
+  /** Always `"response"`, so request and response issues share one shape. */
+  target: "response";
+  /** The part of the response. */
+  part: ResponsePart;
+  /** The schema's message, or the contract's. */
+  message: string;
+  /** Dotted path within the part; `""` for the part itself. */
+  path: string;
+}
+
+/** A response broke its contract (mode `"error"`). Status 500. */
+export class ResponseValidationError extends Error {
+  /** Every mismatch found. */
+  public readonly issues: ResponseIssue[];
+  /** The status the response was going to have. */
+  public readonly responseStatus: number;
+  /** The status to answer with. */
+  public readonly status = 500;
+
+  constructor(issues: ResponseIssue[], responseStatus: number) {
+    super(
+      `Response validation failed (${responseStatus}) — ${issues
+        .map((i) => `${i.part}${i.path ? `.${i.path}` : ""}: ${i.message}`)
+        .join("; ")}`,
+    );
+    this.name = "ResponseValidationError";
+    this.issues = issues;
+    this.responseStatus = responseStatus;
+  }
+}
+
+/** A status's contract, normalised once at construction. */
+interface CompiledSpec {
+  headers: StandardSchemaV1 | undefined;
+  cookies: StandardSchemaV1 | undefined;
+  /** `undefined`: body unchecked; `null`: no body; else by media type. */
+  content: Readonly<Record<string, ContentSpec>> | null | undefined;
+}
+
+/** A compiled contract: status → spec. */
+export type CompiledResponses = Map<number, CompiledSpec>;
+
+function isSchema(value: unknown): value is StandardSchemaV1 {
+  return typeof value === "object" && value !== null && "~standard" in value;
+}
+
+/** Normalises every status once, so the gate does no shape tests per request. */
+export function compileResponses(responses: ResponseSchemas): CompiledResponses {
+  const map: CompiledResponses = new Map();
+  for (const [code, spec] of Object.entries(responses)) {
+    const status = Number(code);
+    if (spec === null) {
+      map.set(status, { headers: undefined, cookies: undefined, content: null });
+    } else if (isSchema(spec)) {
+      map.set(status, { headers: undefined, cookies: undefined, content: { "application/json": spec } });
+    } else {
+      map.set(status, {
+        headers: spec.headers,
+        cookies: spec.cookies,
+        content: spec.content,
+      });
+    }
+  }
+  return map;
+}
+
+function formatPath(issue: StandardSchemaV1.Issue): string {
+  if (!issue.path || issue.path.length === 0) return "";
+  return issue.path
+    .map((s) => (typeof s === "object" && s !== null && "key" in s ? String(s.key) : String(s)))
+    .join(".");
+}
+
+type Found = ResponseIssue[];
+/** Runs one schema; sync when the vendor is. */
+function run(
+  schema: StandardSchemaV1,
+  value: unknown,
+  part: ResponsePart,
+  prefix = "",
+): Found | Promise<Found> {
+  const map = (result: StandardSchemaV1.Result<unknown>): Found =>
+    result.issues
+      ? result.issues.map((issue) => {
+          const path = formatPath(issue);
+          return { target: "response", part, message: issue.message, path: prefix && path ? `${prefix}.${path}` : prefix || path };
+        })
+      : [];
+  const result = schema["~standard"].validate(value);
+  return result instanceof Promise ? result.then(map) : map(result);
+}
+
+const issue = (part: ResponsePart, message: string, path = ""): ResponseIssue => ({
+  target: "response",
+  part,
+  message,
+  path,
+});
+
+function mediaTypeOf(contentType: string | null | undefined): string | undefined {
+  if (!contentType) return undefined;
+  const semi = contentType.indexOf(";");
+  return (semi === -1 ? contentType : contentType.slice(0, semi)).trim().toLowerCase();
+}
+
+function isJsonMedia(media: string): boolean {
+  return media === "application/json" || media.endsWith("+json");
+}
+
+function pickContent(
+  content: Readonly<Record<string, ContentSpec>>,
+  media: string,
+): ContentSpec | undefined {
+  if (media in content) return content[media];
+  const wild = `${media.slice(0, media.indexOf("/"))}/*`;
+  if (wild in content) return content[wild];
+  return "*/*" in content ? content["*/*"] : undefined;
+}
+
+/** The headers a schema sees: lower-case names, `set-cookie` left to `cookies`. */
+function headersObject(response: Response, contentType: string | undefined): Record<string, string> {
+  const out: Record<string, string> = {};
+  response.headers.forEach((value, key) => {
+    if (key !== "set-cookie") out[key] = value;
+  });
+  if (contentType !== undefined && out["content-type"] === undefined) out["content-type"] = contentType;
+  return out;
+}
+
+/** One parsed `Set-Cookie` line. */
+export interface SetCookieView {
+  /** The value as written (URL-decoded; `j:`/`s:` prefixes kept). */
+  value: string;
+  /** `HttpOnly` present. */
+  httpOnly: boolean;
+  /** `Secure` present. */
+  secure: boolean;
+  /** `Partitioned` present. */
+  partitioned: boolean;
+  /** `SameSite`, lower-cased, when present. */
+  sameSite?: string;
+  /** `Path`, when present. */
+  path?: string;
+  /** `Domain`, when present. */
+  domain?: string;
+  /** `Max-Age` in seconds, when present. */
+  maxAge?: number;
+  /** `Expires`, as written, when present. */
+  expires?: string;
+}
+
+function setCookies(response: Response): Record<string, SetCookieView> {
+  const out: Record<string, SetCookieView> = {};
+  for (const line of response.headers.getSetCookie()) {
+    const [pair = "", ...attrs] = line.split(";");
+    const eq = pair.indexOf("=");
+    const name = pair.slice(0, eq).trim();
+    let value = pair.slice(eq + 1).trim();
+    try {
+      value = decodeURIComponent(value);
+    } catch {}
+    const view: SetCookieView = { value, httpOnly: false, secure: false, partitioned: false };
+    for (const attr of attrs) {
+      const i = attr.indexOf("=");
+      const key = (i === -1 ? attr : attr.slice(0, i)).trim().toLowerCase();
+      const v = i === -1 ? "" : attr.slice(i + 1).trim();
+      if (key === "httponly") view.httpOnly = true;
+      else if (key === "secure") view.secure = true;
+      else if (key === "partitioned") view.partitioned = true;
+      else if (key === "samesite") view.sameSite = v.toLowerCase();
+      else if (key === "path") view.path = v;
+      else if (key === "domain") view.domain = v;
+      else if (key === "max-age") view.maxAge = Number(v);
+      else if (key === "expires") view.expires = v;
+    }
+    out[name] = view;
+  }
+  return out;
+}
+
+const decoder = new TextDecoder();
+function toBytes(body: ArrayBufferView | ArrayBufferLike): Uint8Array {
+  return ArrayBuffer.isView(body)
+    ? new Uint8Array(body.buffer, body.byteOffset, body.byteLength)
+    : new Uint8Array(body as ArrayBuffer);
+}
+
+/** The value a whole-body schema sees, by media type: JSON parsed, text decoded, else bytes. */
+function bodyValue(media: string, kind: "json" | "text" | "bytes", body: unknown): { ok: true; value: unknown } | { ok: false } {
+  if (kind === "json") return { ok: true, value: body };
+  if (kind === "text") {
+    if (!isJsonMedia(media)) return { ok: true, value: body };
+    try {
+      return { ok: true, value: JSON.parse(body as string) };
+    } catch {
+      return { ok: false };
+    }
+  }
+  const bytes = body as Uint8Array;
+  if (isJsonMedia(media)) {
+    try {
+      return { ok: true, value: JSON.parse(decoder.decode(bytes)) };
+    } catch {
+      return { ok: false };
+    }
+  }
+  return { ok: true, value: media.startsWith("text/") ? decoder.decode(bytes) : bytes };
+}
+
+/** Per-response state of a stream's chunk checks. */
+class ChunkChecker {
+  #sseBuffer = "";
+  readonly #decoder = new TextDecoder();
+  constructor(
+    readonly spec: StreamChunks | SseEvents,
+    readonly media: string,
+  ) {}
+
+  /** Issues for one chunk (several SSE events may complete in it). */
+  check(chunk: BunResponseChunk): Found | Promise<Found> {
+    if (this.spec.kind === "chunks") {
+      const value = typeof chunk === "string" ? chunk : this.media.startsWith("text/") ? this.#decoder.decode(toBytes(chunk), { stream: true }) : toBytes(chunk);
+      return run(this.spec.chunk, value, "chunk");
+    }
+    this.#sseBuffer += typeof chunk === "string" ? chunk : this.#decoder.decode(toBytes(chunk), { stream: true });
+    const found: (Found | Promise<Found>)[] = [];
+    let end: RegExpExecArray | null;
+    const re = /\r?\n\r?\n/;
+    while ((end = re.exec(this.#sseBuffer)) !== null) {
+      const block = this.#sseBuffer.slice(0, end.index);
+      this.#sseBuffer = this.#sseBuffer.slice(end.index + end[0].length);
+      found.push(this.#checkEvent(block));
+    }
+    return merge(found);
+  }
+
+  #checkEvent(block: string): Found | Promise<Found> {
+    let name = "message";
+    const data: string[] = [];
+    let any = false;
+    for (const line of block.split(/\r?\n/)) {
+      if (line === "" || line.startsWith(":")) continue;
+      any = true;
+      const i = line.indexOf(":");
+      const field = i === -1 ? line : line.slice(0, i);
+      const value = i === -1 ? "" : line.slice(i + 1).replace(/^ /, "");
+      if (field === "event") name = value;
+      else if (field === "data") data.push(value);
+    }
+    if (!any) return [];
+    const events = (this.spec as SseEvents).events;
+    if (!(name in events)) return [issue("event", `event "${name}" is not declared`, name)];
+    const schema = events[name];
+    const text = data.join("\n");
+    if (schema === null) return text === "" ? [] : [issue("event", `event "${name}" declares no data`, name)];
+    let value: unknown = text;
+    try {
+      value = JSON.parse(text);
+    } catch {}
+    return run(schema!, value, "event", name);
+  }
+}
+
+function merge(parts: (Found | Promise<Found>)[]): Found | Promise<Found> {
+  if (parts.some((p) => p instanceof Promise)) return Promise.all(parts).then((xs) => xs.flat());
+  return (parts as Found[]).flat();
+}
+
+/** Options of {@link createResponseGate}. */
+export interface ResponseGateOptions {
+  /** `"warn"` or `"error"` (an `"off"` contract installs no gate). */
+  mode: Exclude<ResponseValidationMode, "off">;
+  /** Where `"warn"` mismatches, and `"error"` ones after a stream started, are logged. */
+  logger: Logger;
+  /** `METHOD path`, for the log line. */
+  route: string;
+}
+
+/**
+ * The gate for one request. Sync vendors decide in place; a Promise holds the
+ * commit in `"error"` mode, and is only logged in `"warn"` mode.
+ */
+export function createResponseGate(
+  compiled: CompiledResponses,
+  { mode, logger, route }: ResponseGateOptions,
+): BunResponseGate {
+  let checker: ChunkChecker | undefined;
+  let warnedStream = false;
+
+  let errorPath = false;
+  const report = (found: Found, status: number): GateVerdict => {
+    if (found.length === 0) return undefined;
+    const error = new ResponseValidationError(found, status);
+    // An error handler's response is only reported: replacing it would mask
+    // the error it renders with a ResponseValidationError.
+    if (mode === "warn" || errorPath) {
+      logger.warn("Response does not match its contract", { route, status, mismatch: error.issues });
+      return undefined;
+    }
+    return { reject: error };
+  };
+  const settle = (found: Found | Promise<Found>, status: number): GateVerdict | Promise<GateVerdict> => {
+    if (!(found instanceof Promise)) return report(found, status);
+    if (mode === "warn" || errorPath) {
+      void found.then((f) => report(f, status));
+      return undefined;
+    }
+    return found.then((f) => report(f, status));
+  };
+
+  /** Wraps a user stream so each chunk is checked on its way out. */
+  const wrapStream = (response: Response, c: ChunkChecker, status: number): Response => {
+    const check = new TransformStream<Uint8Array, Uint8Array>({
+      transform(chunk, controller) {
+        const fail = (found: Found) => {
+          if (found.length === 0) return controller.enqueue(chunk);
+          const error = new ResponseValidationError(found, status);
+          logger[mode === "error" ? "error" : "warn"]("Streamed response chunk does not match its contract", { route, status, mismatch: error.issues });
+          if (mode === "error") controller.error(error);
+          else controller.enqueue(chunk);
+        };
+        const found = c.check(chunk);
+        return found instanceof Promise ? found.then(fail) : fail(found);
+      },
+    });
+    return new Response(response.body!.pipeThrough(check), response);
+  };
+
+  return {
+    commit(_res: BunResponse, response: Response, ctx: GateCommit) {
+      errorPath = ctx.errorPath;
+      const status = response.status;
+      const spec = compiled.get(status);
+      if (spec === undefined) {
+        // A 304 the freshness check made from a conditional request.
+        if (status === 304 && ctx.conditional) return undefined;
+        return settle([issue("status", `status ${status} is not declared (declared: ${[...compiled.keys()].join(", ")})`)], status);
+      }
+      const parts: (Found | Promise<Found>)[] = [];
+      if (spec.headers) parts.push(run(spec.headers, headersObject(response, ctx.contentType), "headers"));
+      if (spec.cookies) parts.push(run(spec.cookies, setCookies(response), "cookies"));
+
+      let replace: Response | undefined;
+      const exempt = ctx.kind === "redirect" || ctx.kind === "status" || status === 204 || status === 205 || status === 304;
+      const content = spec.content;
+      if (!exempt && content !== undefined) {
+        const empty = ctx.kind === "empty" || (ctx.kind === "json" && ctx.body === undefined);
+        if (content === null) {
+          if (!empty) parts.push([issue("body", `status ${status} declares no body`)]);
+        } else {
+          const media = mediaTypeOf(ctx.contentType);
+          const picked = media === undefined ? undefined : pickContent(content, media);
+          if (media === undefined || picked === undefined) {
+            parts.push([issue("body", `media type ${media ?? "(none)"} is not declared for status ${status} (declared: ${Object.keys(content).join(", ")})`)]);
+          } else if (picked === null) {
+            if (!empty) parts.push([issue("body", `${media} declares no body`)]);
+          } else if (!isSchema(picked) && picked.kind === "opaque") {
+            // declared, content not read
+          } else if (!isSchema(picked)) {
+            // chunks() / sse()
+            const c = new ChunkChecker(picked, media);
+            if (ctx.kind === "stream-open") checker = c;
+            else if (ctx.kind === "stream") replace = wrapStream(response, c, status);
+            else if (ctx.kind === "text" || ctx.kind === "bytes") parts.push(c.check(ctx.body as BunResponseChunk));
+            else parts.push([issue("body", `a ${ctx.kind} body cannot be checked per chunk`)]);
+          } else {
+            // A whole-body schema.
+            const kind = ctx.kind;
+            if (kind === "json" || kind === "text" || kind === "bytes") {
+              const v = bodyValue(media, kind, kind === "bytes" ? toBytes(ctx.body as ArrayBufferView) : ctx.body);
+              parts.push(v.ok ? run(picked, v.value, "body") : [issue("body", "body is not valid JSON")]);
+            } else if (kind === "blob" || kind === "file" || kind === "native") {
+              // Read without consuming what is sent: a Blob reads again; a Response is cloned.
+              const source = kind === "native" ? response.clone() : (ctx.body as Blob);
+              parts.push(
+                source.arrayBuffer().then((buf) => {
+                  const v = bodyValue(media, "bytes", new Uint8Array(buf));
+                  return v.ok ? run(picked, v.value, "body") : [issue("body", "body is not valid JSON")];
+                }),
+              );
+            } else if (kind === "empty") {
+              parts.push(run(picked, undefined, "body"));
+            } else if (!warnedStream) {
+              // A stream against a whole-body schema: not buffered; say so once.
+              warnedStream = true;
+              logger.warn("A streamed body is not checked against a whole-body schema; declare chunks() or sse()", { route, status, media });
+            }
+          }
+        }
+      }
+      const verdict = settle(merge(parts), status);
+      if (replace === undefined) return verdict;
+      if (verdict instanceof Promise) return verdict.then((v) => v ?? { replace });
+      return verdict ?? { replace };
+    },
+
+    chunk(_res: BunResponse, chunk: BunResponseChunk) {
+      if (checker === undefined) return undefined;
+      const found = checker.check(chunk);
+      const status = _res.statusCode;
+      const after = (f: Found): GateVerdict => {
+        if (f.length === 0) return undefined;
+        const error = new ResponseValidationError(f, status);
+        logger[mode === "error" ? "error" : "warn"]("Streamed response chunk does not match its contract", { route, status, mismatch: error.issues });
+        return mode === "error" ? { destroy: error } : undefined;
+      };
+      if (!(found instanceof Promise)) return after(found);
+      if (mode === "warn") {
+        // "warn" never holds a chunk back.
+        void found.then(after);
+        return undefined;
+      }
+      return found.then(after);
+    },
+  };
+}
