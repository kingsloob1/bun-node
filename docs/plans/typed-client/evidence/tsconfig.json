{
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "jsx": "react-jsx",
    "lib": [
      "DOM",
      "ESNext"
    ],
    "types": [
      "bun"
    ],
    "noEmit": true,
    "skipLibCheck": true,
    "allowImportingTsExtensions": true
  },
  "include": [
    "swr-core/**/*",
    "bundle-size/**/*"
  ],
  "exclude": [
    "bundle-size/entries/**"
  ]
}
