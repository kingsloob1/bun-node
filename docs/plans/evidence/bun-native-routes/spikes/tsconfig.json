{
  // Spikes for docs/plans/bun-native-routes.md: throwaway probes of what one
  // Bun build's `Bun.serve({ routes })` does, run one at a time with
  // `bun <file>.ts`. This file exists so an editor resolves them against Bun's
  // types. Deliberately not in scripts/typecheck.ts — a spike records what one
  // Bun version did; it is not maintained code.
  "extends": "../../../../../tsconfig.base.json",
  "compilerOptions": { "types": ["bun"], "noEmit": true },
  "include": ["./*.ts"]
}
