{
  // The per-framework props typing spike: one PropsOf<C> resolved through
  // an interface each adapter subpath would augment.
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": ["*.ts", "*.tsx"]
}
