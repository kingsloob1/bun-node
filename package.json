{
  "name": "bun-node",
  "author": "Okafor Obinna <kingsloob1@gmail.com>",
  "description": "Utilities for bun webserver which includes an extended Request, Response, Router, HttpAdapter, Websocket, NestJs compatitble HttpAdapter, NestJs compatitble websocket adapter, NestJs compatitble file decorators and file interceptors",
  "private": true,
  "scripts": {
    "check": "bun scripts/typecheck.ts",
    "format": "bun fmt",
    "format:check": "bun fmt --check",
    "format:check:scripts": "cd scripts && bun fmt --check",
    "format:scripts": "cd scripts && bun fmt",
    "lint:scripts": "cd scripts && bun lint",
    "release": "bun scripts/publish.ts",
    "test:scripts": "cd scripts && bun test --check --parallel --timings=bun-timings.json",
    "test:scripts:timings": "cd scripts && rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "typecheck": "bun scripts/typecheck.ts"
  },
  "workspaces": {
    "packages": [
      "packages/bun-contract",
      "packages/bun-common",
      "packages/bun-nest",
      "packages/bun-jobs",
      "packages/bun-ui",
      "packages/bun-cache",
      "packages/bun-client"
    ],
    "catalog": {
      "@asyncapi/specs": "^6.11.1",
      "@happy-dom/global-registrator": "^20.0.0",
      "@nestjs/common": "^12.4.2",
      "@nestjs/core": "^12.4.2",
      "@nestjs/platform-express": "^12.4.2",
      "@nestjs/websockets": "^12.4.2",
      "@tanstack/query-core": "^5.90.0",
      "@tanstack/react-query": "^5.90.0",
      "@testing-library/dom": "^10.4.0",
      "@testing-library/react": "^16.3.0",
      "@types/bun": "^1.4.2",
      "@types/react": "^19.2.0",
      "@types/react-dom": "^19.2.0",
      "@types/supertest": "^7.2.0",
      "ajv": "^8.20.0",
      "ajv-formats": "^3.0.1",
      "arktype": "^2",
      "bun-types": "^1.4.3",
      "happy-dom": "^20.0.0",
      "mongodb": "^6",
      "react": "^19.2.0",
      "react-dom": "^19.2.0",
      "reflect-metadata": "^0.2.2",
      "rxjs": "^7.8.1",
      "supertest": "^7.2.2",
      "typescript": "^6.0.3",
      "valibot": "^1",
      "yup": "^1",
      "zod": "^4"
    }
  },
  "devDependencies": {
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/websockets": "catalog:",
    "@types/bun": "catalog:",
    "eslint": "^10.5.0",
    "eslint-plugin-regexp": "^3.1.0",
    "lerna": "^10.0.1",
    "nx": "23.2.1",
    "typescript": "catalog:"
  },
  "packageManager": "bun@1.4.4",
  "engines": {
    "bun": ">=1.4.4"
  },
  "dependencies": {}
}
