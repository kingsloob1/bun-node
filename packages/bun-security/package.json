    "type": "git",
    "url": "git+https://github.com/kingsloob1/bun-node.git",
    "directory": "packages/bun-security"
  },
  "bugs": {
    "url": "https://github.com/kingsloob1/bun-node/issues"
  },
  "keywords": [
    "bun",
    "security",
    "waf",
    "firewall",
    "allow-list",
    "deny-list",
    "ip",
    "cidr",
    "trust-proxy",
    "x-forwarded-for",
    "rate-limit",
    "defence"
  ],
  "sideEffects": [
