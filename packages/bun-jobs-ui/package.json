{
  "name": "@kingsleyweb/bun-jobs-ui",
  "type": "module",
  "version": "3.0.0-rc.0",
  "private": false,
  "description": "A React management UI and API documentation viewer for the @kingsleyweb/bun-jobs management API, served by a jobsUi() handler that mounts beside createJobsApi",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "dts",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:types": "bun scripts/build-declarations.ts",
    "prepack": "bun scripts/build.ts && bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check && bun check -p app && bun check -p __tests__/app/pkg",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@kingsleyweb/bun-jobs": "workspace:^",
    "@types/bun": ">=1.4.2"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-common": "workspace:^"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@happy-dom/global-registrator": "catalog:",
    "@kingsleyweb/bun-jobs": "workspace:^",
    "@kingsleyweb/bun-nest": "workspace:^",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-types": "catalog:",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "happy-dom": "catalog:",
    "prettier": "^3.8.4",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:",
    "@kingsleyweb/bun-api-docs-ui": "workspace:^"
  }
}
