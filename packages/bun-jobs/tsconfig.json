{
  // Compiler options live in the repo root's `tsconfig.base.json`. `bench/` is
  // a nested project with its own `node_modules` and config, so it is excluded
  // here and checked from `bench/tsconfig.json`.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "lib/*": ["./lib/*"]
    }
  },
  "include": [
    "./lib/**/*",
    "./__tests__/**/*",
    "./scripts/**/*",
    "eslint.config.mjs"
  ]
}
