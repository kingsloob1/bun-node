{
  "name": "@kingsleyweb/bun-jobs",
  "type": "module",
  "version": "3.0.1",
  "private": false,
  "description": "Background work for Bun: run JS/TS files on a schedule or on demand (child process, Worker or in-process) and queue/process jobs across processes and services, over memory, file, Redis, SQL (postgres/mysql/mariadb/sqlite) and MongoDB drivers",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsloob1/bun-node.git",
    "directory": "packages/bun-jobs"
  },
  "bugs": {
    "url": "https://github.com/kingsloob1/bun-node/issues"
  },
  "homepage": "https://github.com/kingsloob1/bun-node/tree/develop/packages/bun-jobs#readme",
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./api/contract": {
      "@kingsleyweb/source": "./lib/api/contract/index.ts",
      "types": "./dts/api/contract/index.d.ts",
      "default": "./lib/api/contract/index.ts"
    },
    "./container-entry": {
      "@kingsleyweb/source": "./lib/runner/bootstrap/container-entry.ts",
      "types": "./dts/runner/bootstrap/container-entry.d.ts",
      "default": "./lib/runner/bootstrap/container-entry.ts"
    },
    "./provider": {
      "@kingsleyweb/source": "./lib/provider/index.ts",
      "types": "./dts/provider/index.d.ts",
      "default": "./lib/provider/index.ts"
    },
    "./provider/testing": {
      "@kingsleyweb/source": "./lib/provider/testing/index.ts",
      "types": "./dts/provider/testing/index.d.ts",
      "default": "./lib/provider/testing/index.ts"
    },
    "./remote": {
      "@kingsleyweb/source": "./lib/remote/index.ts",
      "types": "./dts/remote/index.d.ts",
      "default": "./lib/remote/index.ts"
    },
    "./summon": {
      "@kingsleyweb/source": "./lib/summon/index.ts",
      "types": "./dts/summon/index.d.ts",
      "default": "./lib/summon/index.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib/api": {
      "@kingsleyweb/source": "./lib/api/index.ts",
      "types": "./dts/api/index.d.ts",
      "default": "./lib/api/index.ts"
    },
    "./lib/api/contract": {
      "@kingsleyweb/source": "./lib/api/contract/index.ts",
      "types": "./dts/api/contract/index.d.ts",
      "default": "./lib/api/contract/index.ts"
    },
    "./lib/drivers": {
      "@kingsleyweb/source": "./lib/drivers/index.ts",
      "types": "./dts/drivers/index.d.ts",
      "default": "./lib/drivers/index.ts"
    },
    "./lib/provider": {
      "@kingsleyweb/source": "./lib/provider/index.ts",
      "types": "./dts/provider/index.d.ts",
      "default": "./lib/provider/index.ts"
    },
    "./lib/provider/testing": {
      "@kingsleyweb/source": "./lib/provider/testing/index.ts",
      "types": "./dts/provider/testing/index.d.ts",
      "default": "./lib/provider/testing/index.ts"
    },
    "./lib/queue": {
      "@kingsleyweb/source": "./lib/queue/index.ts",
      "types": "./dts/queue/index.d.ts",
      "default": "./lib/queue/index.ts"
    },
    "./lib/remote": {
      "@kingsleyweb/source": "./lib/remote/index.ts",
      "types": "./dts/remote/index.d.ts",
      "default": "./lib/remote/index.ts"
    },
    "./lib/runner": {
      "@kingsleyweb/source": "./lib/runner/index.ts",
      "types": "./dts/runner/index.d.ts",
      "default": "./lib/runner/index.ts"
    },
    "./lib/summon": {
      "@kingsleyweb/source": "./lib/summon/index.ts",
      "types": "./dts/summon/index.d.ts",
      "default": "./lib/summon/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "sideEffects": [
    "./lib/provider/testing/racer.ts",
    "./lib/provider/testing/worker.ts",
    "./lib/runner/bootstrap/container-entry.ts",
    "./lib/runner/bootstrap/container-runtime.ts",
    "./lib/runner/bootstrap/spawn-entry.ts",
    "./lib/runner/bootstrap/worker-entry.ts"
  ],
  "files": [
    "docs",
    "dts",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build:types": "bun scripts/build-declarations.ts",
    "bun-version": "bun --version",
    "prepack": "bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:seeded": "bun scripts/test-seeded.ts",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@types/bun": ">=1.4.2",
    "chrono-node": ">=2.7.0 <3",
    "mongodb": ">=6",
    "typescript": "^5.9.3 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "chrono-node": {
      "optional": true
    },
    "mongodb": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-common": "workspace:^"
  },
  "devDependencies": {
    "@asyncapi/specs": "catalog:",
    "@types/bun": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "bun-types": "catalog:",
    "chrono-node": "^2.7.0",
    "mongodb": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
