{
  // The package `tsconfig.json` includes `__tests__/` too, and the package's
  // `bun run check` checks the tests through it. This config is the nearest
  // one to a test file, so it is what the IDE, `bun test --check` and
  // `bun check <file>` use for one: the package's options, unchanged.
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "noEmit": true
  },
  "include": ["./**/*"]
}
