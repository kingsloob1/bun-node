{
  "name": "@kingsleyweb/bun-api-docs-ui",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "A self-hosted viewer for one OpenAPI 3.1 or AsyncAPI 3.0 document, served by a docsUi() handler: a bundled React app with hash-named immutable assets, computed SRI and a strict self-only CSP",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json",
    "./embed": {
      "@kingsleyweb/source": "./app/embed.ts",
      "types": "./app/embed.ts",
      "default": "./app/embed.ts"
    },
    "./embed/routing": {
      "@kingsleyweb/source": "./app/routing.ts",
      "types": "./app/routing.ts",
      "default": "./app/routing.ts"
    },
    "./embed/router": {
      "@kingsleyweb/source": "./app/router.tsx",
      "types": "./app/router.tsx",
      "default": "./app/router.tsx"
    },
    "./embed/context": {
      "@kingsleyweb/source": "./app/context.ts",
      "types": "./app/context.ts",
      "default": "./app/context.ts"
    },
    "./embed/permissions": {
      "@kingsleyweb/source": "./app/screens/docs/permissions.ts",
      "types": "./app/screens/docs/permissions.ts",
      "default": "./app/screens/docs/permissions.ts"
    },
    "./embed/client": {
      "@kingsleyweb/source": "./app/api/client.ts",
      "types": "./app/api/client.ts",
      "default": "./app/api/client.ts"
    },
    "./embed/errors": {
      "@kingsleyweb/source": "./app/api/errors.ts",
      "types": "./app/api/errors.ts",
      "default": "./app/api/errors.ts"
    }
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "app",
    "dist",
    "dts",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:types": "bun scripts/build-declarations.ts",
    "prepack": "bun scripts/build.ts && bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check && bun check -p app",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@types/bun": ">=1.4.2"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-common": "^2.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@happy-dom/global-registrator": "^20.0.0",
    "@kingsleyweb/bun-jobs": "^2.2.0",
    "@tanstack/react-query": "^5.90.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/react": "^16.3.0",
    "@types/bun": "^1.4.2",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "bun-types": "^1.4.3",
    "eslint": "^10.5.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react-hooks": "^7.0.0",
    "eslint-plugin-react-refresh": "^0.5.2",
    "happy-dom": "^20.0.0",
    "prettier": "^3.8.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "typescript": "^6.0.3"
  }
}
