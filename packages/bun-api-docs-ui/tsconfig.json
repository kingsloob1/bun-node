{
  // Compiler options live in the repo root's `tsconfig.base.json`. `app/` is
  // the browser bundle: it needs the DOM lib, so it is its own project, checked
  // from `app/tsconfig.json` (the package's `check` script runs both), and
  // excluded here.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "lib/*": ["./lib/*"]
    }
  },
  "include": [
    "./lib/**/*",
    "./scripts/**/*",
    "./__tests__/server/**/*",
    "eslint.legacy.config.mjs"
  ]
}
