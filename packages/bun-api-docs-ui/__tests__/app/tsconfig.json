{
  // Exists so `bun test --check` and editors check the app's tests with
  // `app/tsconfig.json`'s DOM libs and types: both use a file's NEAREST
  // tsconfig, which without this one is the package's DOM-free config.
  // `include` and `exclude` are inherited, so they resolve from app/ and
  // cover the same files.
  "extends": "../../app/tsconfig.json"
}
