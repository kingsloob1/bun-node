{
  "name": "@kingsleyweb/bun-nest",
  "type": "module",
  "version": "3.1.0",
  "private": false,
  "description": "NestJS on Bun: an HTTP adapter matching @nestjs/platform-express, multer-style file upload interceptors, a WebSocket adapter for @WebSocketGateway, and caching modules and decorators over @kingsleyweb/bun-cache, built on @kingsleyweb/bun-common",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kingsloob1/bun-node/tree/develop/packages/bun-nest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsloob1/bun-node.git",
    "directory": "packages/bun-nest"
  },
  "bugs": {
    "url": "https://github.com/kingsloob1/bun-node/issues"
  },
  "keywords": [
    "bun",
    "nestjs",
    "nest",
    "adapter",
    "http-adapter",
    "websocket",
    "gateway",
    "file-upload",
    "multipart"
  ],
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./cache": {
      "@kingsleyweb/source": "./lib/cache/index.ts",
      "types": "./dts/cache/index.d.ts",
      "default": "./lib/cache/index.ts"
    },
    "./jobs": {
      "@kingsleyweb/source": "./lib/jobs/index.ts",
      "types": "./dts/jobs/index.d.ts",
      "default": "./lib/jobs/index.ts"
    },
    "./jobs/testing": {
      "@kingsleyweb/source": "./lib/jobs/testing/index.ts",
      "types": "./dts/jobs/testing/index.d.ts",
      "default": "./lib/jobs/testing/index.ts"
    },
    "./jobs/terminus": {
      "@kingsleyweb/source": "./lib/jobs/terminus/index.ts",
      "types": "./dts/jobs/terminus/index.d.ts",
      "default": "./lib/jobs/terminus/index.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib/cache": {
      "@kingsleyweb/source": "./lib/cache/index.ts",
      "types": "./dts/cache/index.d.ts",
      "default": "./lib/cache/index.ts"
    },
    "./lib/jobs": {
      "@kingsleyweb/source": "./lib/jobs/index.ts",
      "types": "./dts/jobs/index.d.ts",
      "default": "./lib/jobs/index.ts"
    },
    "./lib/jobs/terminus": {
      "@kingsleyweb/source": "./lib/jobs/terminus/index.ts",
      "types": "./dts/jobs/terminus/index.d.ts",
      "default": "./lib/jobs/terminus/index.ts"
    },
    "./lib/jobs/testing": {
      "@kingsleyweb/source": "./lib/jobs/testing/index.ts",
      "types": "./dts/jobs/testing/index.d.ts",
      "default": "./lib/jobs/testing/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "sideEffects": false,
  "files": [
    "dts",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build:types": "bun scripts/build-declarations.ts",
    "bun-version": "bun --version",
    "prepack": "bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@kingsleyweb/bun-cache": "workspace:^",
    "@kingsleyweb/bun-jobs": "workspace:^",
    "@nestjs/common": "^11.1.20 || ^12.0.0",
    "@nestjs/core": "^11.1.20 || ^12.0.0",
    "@nestjs/microservices": "^11.1.20 || ^12.0.0",
    "@nestjs/terminus": "^11.1.1 || ^12.0.0",
    "@nestjs/websockets": "^11.1.20 || ^12.0.0",
    "@types/bun": ">=1.4.2",
    "rxjs": "^7.1.0",
    "typescript": "^5.9.3 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@kingsleyweb/bun-cache": {
      "optional": true
    },
    "@kingsleyweb/bun-jobs": {
      "optional": true
    },
    "@nestjs/microservices": {
      "optional": true
    },
    "@nestjs/terminus": {
      "optional": true
    },
    "@nestjs/websockets": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-common": "workspace:^"
  },
  "devDependencies": {
    "@kingsleyweb/bun-cache": "workspace:^",
    "@kingsleyweb/bun-client": "workspace:^",
    "@kingsleyweb/bun-jobs": "workspace:^",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@nestjs/microservices": "^12.4.2",
    "@nestjs/platform-express": "catalog:",
    "@nestjs/platform-ws": "^12.4.2",
    "@nestjs/swagger": "12.0.4",
    "@nestjs/terminus": "12.1.0",
    "@nestjs/testing": "12.4.2",
    "@nestjs/websockets": "catalog:",
    "@routejs/router": "^3.0.3",
    "@tanstack/query-core": "catalog:",
    "@types/bun": "catalog:",
    "@types/cookie-parser": "^1.4.10",
    "@types/supertest": "catalog:",
    "bun-types": "catalog:",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "cookie-parser": "^1.4.7",
    "ejs": "^7.0.1",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "ws": "8.22.0",
    "yup": "catalog:",
    "zod": "catalog:"
  },
  "gitHead": "58f50ad7df6fde1d9853b1a23b7b2f8a3967b8a1",
  "trustedDependencies": [
    "@nestjs/core"
  ]
}
