{
  "name": "@kingsleyweb/bun-nest",
  "type": "module",
  "version": "2.2.0",
  "private": false,
  "description": "NestJS on Bun: an HTTP adapter matching @nestjs/platform-express, multer-style file upload interceptors and a WebSocket adapter for @WebSocketGateway, built on @kingsleyweb/bun-common",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kingsloob1/bun-node/tree/develop/packages/bun-nest#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsloob1/bun-node.git",
    "directory": "packages/bun-nest"
  },
  "bugs": {
    "url": "https://github.com/kingsloob1/bun-node/issues"
  },
  "keywords": [
    "bun",
    "nestjs",
    "nest",
    "adapter",
    "http-adapter",
    "websocket",
    "gateway",
    "file-upload",
    "multipart"
  ],
  "main": "lib/index.ts",
  "types": "lib/index.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "bun-version": "bun --version",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "peerDependencies": {
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/websockets": "^11.0.0",
    "@types/bun": ">=1.4.2",
    "rxjs": "^7.1.0",
    "typescript": "^5.9.3 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@nestjs/websockets": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-common": "^2.2.0"
  },
  "devDependencies": {
    "@antfu/eslint-config": "^9.0.0",
    "@nestjs/common": "^11.1.27",
    "@nestjs/core": "^11.1.27",
    "@nestjs/websockets": "^11.1.21",
    "@routejs/router": "^3.0.3",
    "@types/bun": "^1.4.2",
    "@types/supertest": "^7.2.0",
    "bun-types": "^1.4.2",
    "eslint": "^10.4.0",
    "eslint-config-prettier": "^10.0.1",
    "eslint-plugin-prettier": "^5.2.2",
    "prettier": "^3.4.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "supertest": "^7.1.4",
    "typescript": "^6.0.3"
  },
  "gitHead": "58f50ad7df6fde1d9853b1a23b7b2f8a3967b8a1",
  "trustedDependencies": [
    "@nestjs/core"
  ]
