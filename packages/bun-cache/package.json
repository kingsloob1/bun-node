{
  "name": "@kingsleyweb/bun-cache",
  "type": "module",
  "version": "0.1.0",
  "private": false,
  "description": "Caching over pluggable drivers for Bun: one typed API (TTLs, tags, single-flight, stale-while-revalidate, counters) over memory, file, SQLite, Postgres, MySQL and MariaDB drivers today, with MongoDB, Redis and S3 to follow, an HTTP response cache for bun-common (./http), and a conformance kit for custom drivers",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kingsloob1/bun-node/tree/develop/packages/bun-cache#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsloob1/bun-node.git",
    "directory": "packages/bun-cache"
  },
  "bugs": {
    "url": "https://github.com/kingsloob1/bun-node/issues"
  },
  "keywords": [
    "bun",
    "cache",
    "caching",
    "ttl",
    "tags",
    "single-flight",
    "stale-while-revalidate",
    "memory",
    "postgres",
    "mysql",
    "mariadb",
    "http",
    "response-cache"
  ],
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./testing": {
      "@kingsleyweb/source": "./lib/testing/index.ts",
      "types": "./dts/testing/index.d.ts",
      "default": "./lib/testing/index.ts"
    },
    "./lib/testing": {
      "@kingsleyweb/source": "./lib/testing/index.ts",
      "types": "./dts/testing/index.d.ts",
      "default": "./lib/testing/index.ts"
    },
    "./http": {
      "@kingsleyweb/source": "./lib/http/index.ts",
      "types": "./dts/http/index.d.ts",
      "default": "./lib/http/index.ts"
    },
    "./lib/http": {
      "@kingsleyweb/source": "./lib/http/index.ts",
      "types": "./dts/http/index.d.ts",
      "default": "./lib/http/index.ts"
    },
    "./lib/drivers": {
      "@kingsleyweb/source": "./lib/drivers/index.ts",
      "types": "./dts/drivers/index.d.ts",
      "default": "./lib/drivers/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "dts",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build:types": "bun scripts/build-declarations.ts",
    "bun-version": "bun --version",
    "prepack": "bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@types/bun": ">=1.4.2",
    "typescript": "^5.9.3 || ^6.0.0"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "typescript": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-common": "^2.2.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "bun-types": "^1.4.3",
    "typescript": "^6.0.3",
    "zod": "^4"
  }
}
