{
  "name": "@kingsleyweb/bun-common",
  "type": "module",
  "version": "3.2.0",
  "private": false,
  "description": "An Express-like HTTP layer for Bun.serve: BunRouter with Express 5 semantics, BunHttpAdapter, BunRequest/BunResponse, Standard Schema validation, CORS, static files, compression, multipart uploads, WebSockets and structured logging",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kingsloob1/bun-node/tree/develop/packages/bun-common#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsloob1/bun-node.git",
    "directory": "packages/bun-common"
  },
  "bugs": {
    "url": "https://github.com/kingsloob1/bun-node/issues"
  },
  "keywords": [
    "bun",
    "http",
    "router",
    "express",
    "middleware",
    "websocket",
    "multipart",
    "validation",
    "standard-schema",
    "cors"
  ],
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./contract": {
      "@kingsleyweb/source": "./lib/contract/index.ts",
      "types": "./dts/contract/index.d.ts",
      "default": "./lib/contract/index.ts"
    },
    "./lib/contract": {
      "@kingsleyweb/source": "./lib/contract/index.ts",
      "types": "./dts/contract/index.d.ts",
      "default": "./lib/contract/index.ts"
    },
    "./sse": {
      "@kingsleyweb/source": "./lib/sse/index.ts",
      "types": "./dts/sse/index.d.ts",
      "default": "./lib/sse/index.ts"
    },
    "./lib/sse": {
      "@kingsleyweb/source": "./lib/sse/index.ts",
      "types": "./dts/sse/index.d.ts",
      "default": "./lib/sse/index.ts"
    },
    "./live": {
      "@kingsleyweb/source": "./lib/live/index.ts",
      "types": "./dts/live/index.d.ts",
      "default": "./lib/live/index.ts"
    },
    "./lib/live": {
      "@kingsleyweb/source": "./lib/live/index.ts",
      "types": "./dts/live/index.d.ts",
      "default": "./lib/live/index.ts"
    },
    "./webrtc": {
      "@kingsleyweb/source": "./lib/webrtc/index.ts",
      "types": "./dts/webrtc/index.d.ts",
      "default": "./lib/webrtc/index.ts"
    },
    "./lib/webrtc": {
      "@kingsleyweb/source": "./lib/webrtc/index.ts",
      "types": "./dts/webrtc/index.d.ts",
      "default": "./lib/webrtc/index.ts"
    },
    "./lib/docs": {
      "@kingsleyweb/source": "./lib/docs/index.ts",
      "types": "./dts/docs/index.d.ts",
      "default": "./lib/docs/index.ts"
    },
    "./lib/docs/types": {
      "@kingsleyweb/source": "./lib/docs/types.ts",
      "types": "./dts/docs/types.d.ts",
      "default": "./lib/docs/types.ts"
    },
    "./lib/multipart": {
      "@kingsleyweb/source": "./lib/multipart/index.ts",
      "types": "./dts/multipart/index.d.ts",
      "default": "./lib/multipart/index.ts"
    },
    "./lib/multipart/storage": {
      "@kingsleyweb/source": "./lib/multipart/storage/index.ts",
      "types": "./dts/multipart/storage/index.d.ts",
      "default": "./lib/multipart/storage/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "sideEffects": [
    "./lib/contract/describe.ts",
    "./lib/contract/guard.ts",
    "./lib/contract/index.ts",
    "./lib/contract/logger.ts"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "dts",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build:types": "bun scripts/build-declarations.ts",
    "bun-version": "bun --version",
    "prepack": "bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@types/bun": ">=1.4.2",
    "typescript": "^5.9.3 || ^6.0.0",
    "@kingsleyweb/bun-ui": "workspace:^"
  },
  "peerDependenciesMeta": {
    "@types/bun": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "@kingsleyweb/bun-ui": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-contract": "workspace:^",
    "@routejs/router": "^3.0.3",
    "@types/accepts": "^1.3.7",
    "@types/busboy": "^1.5.4",
    "@types/type-is": "^1.6.7",
    "accepts": "^1.3.8",
    "busboy": "^1.6.0",
    "file-type": "^22.0.1",
    "mime": "^4.0.6",
    "parse-domain": "^8.3.1",
    "picoquery": "^2.5.0",
    "type-is": "^2.1.0"
  },
  "devDependencies": {
    "@asyncapi/specs": "catalog:",
    "@types/bun": "catalog:",
    "@types/supertest": "catalog:",
    "@valibot/to-json-schema": "1.8.0",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "arktype": "catalog:",
    "bun-types": "catalog:",
    "class-transformer": "0.5.1",
    "class-validator": "0.15.1",
    "class-validator-jsonschema": "5.2.0",
    "path-to-regexp": "8.4.2",
    "superstruct": "^2",
    "supertest": "catalog:",
    "typescript": "catalog:",
    "valibot": "catalog:",
    "yup": "catalog:",
    "zod": "catalog:",
    "@kingsleyweb/bun-ui": "workspace:^"
  },
  "gitHead": "58f50ad7df6fde1d9853b1a23b7b2f8a3967b8a1"
}
