{
  // Compiler options live in the repo root's `tsconfig.base.json`; see the note
  // there for why. `bench/` and `playground/` are nested projects with configs
  // of their own, so they are excluded here and checked from their own.
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "paths": {
      "lib/*": ["./lib/*"],
      "utils/*": ["./lib/utils/*"]
    }
  },
  "include": [
    "./lib/**/*",
    "./__tests__/**/*",
    "./scripts/**/*",
    "eslint.config.mjs"
  ]
}
