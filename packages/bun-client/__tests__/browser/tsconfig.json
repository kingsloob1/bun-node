{
  // `lib/` as a browser sees it: the DOM lib and no Bun or Node types, so a
  // Bun or Node global used in `lib/` fails this check. A project of its own
  // (the package's `check` script and `scripts/typecheck.ts` run it), kept
  // outside `lib/` so the published package carries no tsconfig beside its
  // sources. The tests, which need Bun's types, are `../../tsconfig.json`.
  "extends": "../../../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": []
  },
  // Its own `*.type-test.ts` files: assertions that need the DOM lib (the
  // browser's `RTCPeerConnection` as `connectPeer`'s, PR-R1).
  "include": ["../../lib/**/*", "./**/*.ts"],
  // The generator is Bun-only and dev-time (plan §10.1: `./codegen` is not
  // browser-safe); the root project checks it with Bun's types.
  "exclude": ["../../lib/codegen/**/*"]
}
