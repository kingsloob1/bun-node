{
  // Compiler options live in the repo root's `tsconfig.base.json`; see the note
  // there for why. `lib/` is browser code: the consumer check's `browser`
  // cells check its declarations with the DOM lib and no Bun or Node types,
  // and `__tests__/bundleSafety.test.ts` bundles it for a browser. It is also
  // checked alone by `__tests__/browser/tsconfig.json` (the DOM lib, no Bun
  // types).
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "types": ["bun"]
  },
  "include": ["./lib/**/*", "./__tests__/**/*", "./scripts/**/*"],
  // The declaration build's DOM reference: never in a program with
  // bun-common's sources, whose Bun-typed streams and headers the DOM lib
  // contradicts. `__tests__/browser/` holds the DOM-typed assertions its own
  // project checks.
  "exclude": ["./lib/dom.d.ts", "./__tests__/browser/**/*"]
}
