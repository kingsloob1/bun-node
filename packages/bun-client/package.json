{
  "name": "@kingsleyweb/bun-client",
  "type": "module",
  "version": "3.0.0-rc.1",
  "private": false,
  "description": "A typed, dependency-free HTTP client for the bun-node servers: one call per verb keyed by the server's own path literal, named operations, typed params, query and body, results discriminated by status, retries with backoff and Retry-After, timeouts, middleware and single-flight auth refresh; typed, resumable server-sent events; typed WebSocket channels with requests, reconnection and backpressure; WebRTC peers over a typed signalling channel. Browser-safe.",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "homepage": "https://github.com/kingsloob1/bun-node/tree/develop/packages/bun-client#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsloob1/bun-node.git",
    "directory": "packages/bun-client"
  },
  "bugs": {
    "url": "https://github.com/kingsloob1/bun-node/issues"
  },
  "keywords": [
    "bun",
    "http-client",
    "fetch",
    "typed",
    "type-safe",
    "openapi",
    "retry",
    "sse",
    "websocket",
    "webrtc",
    "browser"
  ],
  "sideEffects": false,
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./codegen": {
      "@kingsleyweb/source": "./lib/codegen/index.ts",
      "types": "./dts/codegen/index.d.ts",
      "default": "./lib/codegen/index.ts"
    },
    "./zod": {
      "@kingsleyweb/source": "./lib/zod.ts",
      "types": "./dts/zod.d.ts",
      "default": "./lib/zod.ts"
    },
    "./query": {
      "@kingsleyweb/source": "./lib/query.ts",
      "types": "./dts/query.d.ts",
      "default": "./lib/query.ts"
    },
    "./react": {
      "@kingsleyweb/source": "./lib/react.ts",
      "types": "./dts/react.d.ts",
      "default": "./lib/react.ts"
    },
    "./persist": {
      "@kingsleyweb/source": "./lib/persist.ts",
      "types": "./dts/persist.d.ts",
      "default": "./lib/persist.ts"
    },
    "./sse": {
      "@kingsleyweb/source": "./lib/sse.ts",
      "types": "./dts/sse.d.ts",
      "default": "./lib/sse.ts"
    },
    "./channel": {
      "@kingsleyweb/source": "./lib/channel.ts",
      "types": "./dts/channel.d.ts",
      "default": "./lib/channel.ts"
    },
    "./graphql": {
      "@kingsleyweb/source": "./lib/graphql.ts",
      "types": "./dts/graphql.d.ts",
      "default": "./lib/graphql.ts"
    },
    "./webrtc": {
      "@kingsleyweb/source": "./lib/webrtc.ts",
      "types": "./dts/webrtc.d.ts",
      "default": "./lib/webrtc.ts"
    },
    "./lib/codegen": {
      "@kingsleyweb/source": "./lib/codegen/index.ts",
      "types": "./dts/codegen/index.d.ts",
      "default": "./lib/codegen/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "bin": {
    "bun-client": "./lib/codegen/cli.ts"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "directories": {
    "lib": "lib",
    "test": "__tests__"
  },
  "files": [
    "dts",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build:types": "bun scripts/build-declarations.ts",
    "bun-version": "bun --version",
    "prepack": "bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check && bun check -p __tests__/browser",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "dependencies": {
    "@kingsleyweb/bun-contract": "workspace:^"
  },
  "peerDependencies": {
    "@kingsleyweb/bun-common": "workspace:^",
    "@tanstack/query-core": "^5.90.0",
    "@tanstack/query-persist-client-core": "^5.90.0",
    "@tanstack/react-query": "^5.90.0",
    "@types/bun": ">=1.4.2",
    "react": "^19.0.0",
    "typescript": "^5.9.3 || ^6.0.0",
    "zod": "^4"
  },
  "peerDependenciesMeta": {
    "@kingsleyweb/bun-common": {
      "optional": true
    },
    "@tanstack/query-core": {
      "optional": true
    },
    "@tanstack/query-persist-client-core": {
      "optional": true
    },
    "@tanstack/react-query": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "typescript": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@kingsleyweb/bun-cache": "workspace:^",
    "@kingsleyweb/bun-common": "workspace:^",
    "@tanstack/query-core": "catalog:",
    "@tanstack/query-persist-client-core": "5.103.1",
    "@tanstack/react-query": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-types": "catalog:",
    "happy-dom": "catalog:",
    "node-datachannel": "0.33.6",
    "react": "catalog:",
    "react-dom": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
