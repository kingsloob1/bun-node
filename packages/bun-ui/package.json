{
  "name": "@kingsleyweb/bun-ui",
  "type": "module",
  "version": "3.0.0-rc.0",
  "private": false,
  "description": "Every bun-node browser UI in one package, one subpath each: the bun-jobs management UI (./jobs, jobsUi()), each served by a bun-common router with a prebuilt React bundle, hash-named immutable assets, SRI and a strict CSP",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./jobs": {
      "@kingsleyweb/source": "./lib/jobs/index.ts",
      "types": "./dts/jobs/index.d.ts",
      "default": "./lib/jobs/index.ts"
    },
    "./jobs/browser": {
      "@kingsleyweb/source": "./lib/jobs/browser/index.ts",
      "types": "./dts/jobs/browser/index.d.ts",
      "default": "./lib/jobs/browser/index.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib/jobs": {
      "@kingsleyweb/source": "./lib/jobs/index.ts",
      "types": "./dts/jobs/index.d.ts",
      "default": "./lib/jobs/index.ts"
    },
    "./lib/jobs/browser": {
      "@kingsleyweb/source": "./lib/jobs/browser/index.ts",
      "types": "./dts/jobs/browser/index.d.ts",
      "default": "./lib/jobs/browser/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist",
    "dts",
    "guides",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:types": "bun scripts/build-declarations.ts",
    "prepack": "bun scripts/build.ts && bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check && bun check -p app && bun check -p __tests__/jobs/app/pkg",
    "gen:client": "bun-client generate --module scripts/jobs/routes-openapi.ts --out app/jobs/api/routes.gen.ts",
    "check:client": "bun-client generate --module scripts/jobs/routes-openapi.ts --out app/jobs/api/routes.gen.ts --check",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@kingsleyweb/bun-jobs": "workspace:^",
    "@types/bun": ">=1.4.2"
  },
  "peerDependenciesMeta": {
    "@kingsleyweb/bun-jobs": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-api-docs-ui": "workspace:^",
    "@kingsleyweb/bun-common": "workspace:^"
  },
  "devDependencies": {
    "@antfu/eslint-config": "catalog:",
    "@happy-dom/global-registrator": "catalog:",
    "@kingsleyweb/bun-client": "workspace:^",
    "@kingsleyweb/bun-jobs": "workspace:^",
    "@kingsleyweb/bun-nest": "workspace:^",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-types": "catalog:",
    "eslint": "catalog:",
    "eslint-config-prettier": "catalog:",
    "eslint-plugin-prettier": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "eslint-plugin-react-refresh": "catalog:",
    "happy-dom": "catalog:",
    "prettier": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  }
}
