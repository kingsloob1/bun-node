{
  "name": "@kingsleyweb/bun-ui",
  "type": "module",
  "version": "3.2.0",
  "private": false,
  "description": "Every bun-node browser UI in one package, one subpath each: the bun-jobs management UI (./jobs, jobsUi()) and the OpenAPI/AsyncAPI docs viewer (./docs, docsUi()), each served by a bun-common router with a prebuilt React bundle, hash-named immutable assets, SRI and a strict CSP",
  "author": "okafor obinna <kingsloob1@gmail.com>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kingsloob1/bun-node.git",
    "directory": "packages/bun-ui"
  },
  "homepage": "https://github.com/kingsloob1/bun-node/tree/develop/packages/bun-ui#readme",
  "bugs": {
    "url": "https://github.com/kingsloob1/bun-node/issues"
  },
  "exports": {
    ".": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./jobs": {
      "@kingsleyweb/source": "./lib/jobs/index.ts",
      "types": "./dts/jobs/index.d.ts",
      "default": "./lib/jobs/index.ts"
    },
    "./jobs/browser": {
      "@kingsleyweb/source": "./lib/jobs/browser/index.ts",
      "types": "./dts/jobs/browser/index.d.ts",
      "default": "./lib/jobs/browser/index.ts"
    },
    "./docs": {
      "@kingsleyweb/source": "./lib/docs/index.ts",
      "types": "./dts/docs/index.d.ts",
      "default": "./lib/docs/index.ts"
    },
    "./docs/browser": {
      "@kingsleyweb/source": "./lib/docs/browser/index.ts",
      "types": "./dts/docs/browser/index.d.ts",
      "default": "./lib/docs/browser/index.ts"
    },
    "./docs/hosted": {
      "@kingsleyweb/source": "./lib/docs/hosted.ts",
      "types": "./dts/docs/hosted.d.ts",
      "default": "./lib/docs/hosted.ts"
    },
    "./docs/embed": {
      "@kingsleyweb/source": "./app/docs/embed.ts",
      "types": "./app/docs/embed.ts",
      "default": "./app/docs/embed.ts"
    },
    "./docs/embed/routing": {
      "@kingsleyweb/source": "./app/docs/routing.ts",
      "types": "./app/docs/routing.ts",
      "default": "./app/docs/routing.ts"
    },
    "./docs/embed/router": {
      "@kingsleyweb/source": "./app/docs/router.tsx",
      "types": "./app/docs/router.tsx",
      "default": "./app/docs/router.tsx"
    },
    "./docs/embed/context": {
      "@kingsleyweb/source": "./app/docs/context.ts",
      "types": "./app/docs/context.ts",
      "default": "./app/docs/context.ts"
    },
    "./docs/embed/permissions": {
      "@kingsleyweb/source": "./app/docs/screens/docs/permissions.ts",
      "types": "./app/docs/screens/docs/permissions.ts",
      "default": "./app/docs/screens/docs/permissions.ts"
    },
    "./docs/embed/client": {
      "@kingsleyweb/source": "./app/docs/api/client.ts",
      "types": "./app/docs/api/client.ts",
      "default": "./app/docs/api/client.ts"
    },
    "./docs/embed/errors": {
      "@kingsleyweb/source": "./app/docs/api/errors.ts",
      "types": "./app/docs/api/errors.ts",
      "default": "./app/docs/api/errors.ts"
    },
    "./docs/embed/unauthorized": {
      "@kingsleyweb/source": "./app/kit/unauthorized.ts",
      "types": "./app/kit/unauthorized.ts",
      "default": "./app/kit/unauthorized.ts"
    },
    "./lib": {
      "@kingsleyweb/source": "./lib/index.ts",
      "types": "./dts/index.d.ts",
      "default": "./lib/index.ts"
    },
    "./lib/jobs": {
      "@kingsleyweb/source": "./lib/jobs/index.ts",
      "types": "./dts/jobs/index.d.ts",
      "default": "./lib/jobs/index.ts"
    },
    "./lib/jobs/browser": {
      "@kingsleyweb/source": "./lib/jobs/browser/index.ts",
      "types": "./dts/jobs/browser/index.d.ts",
      "default": "./lib/jobs/browser/index.ts"
    },
    "./lib/docs": {
      "@kingsleyweb/source": "./lib/docs/index.ts",
      "types": "./dts/docs/index.d.ts",
      "default": "./lib/docs/index.ts"
    },
    "./lib/docs/browser": {
      "@kingsleyweb/source": "./lib/docs/browser/index.ts",
      "types": "./dts/docs/browser/index.d.ts",
      "default": "./lib/docs/browser/index.ts"
    },
    "./lib/*.ts": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*.js": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./lib/*": {
      "@kingsleyweb/source": "./lib/*.ts",
      "types": "./dts/*.d.ts",
      "default": "./lib/*.ts"
    },
    "./package.json": "./package.json"
  },
  "main": "lib/index.ts",
  "types": "dts/index.d.ts",
  "sideEffects": [
    "**/*.css",
    "./app/*/main.tsx"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "app/docs",
    "app/kit",
    "dist",
    "dts",
    "guides",
    "lib"
  ],
  "engines": {
    "bun": ">=1.4.2"
  },
  "scripts": {
    "build": "bun scripts/build.ts",
    "build:types": "bun scripts/build-declarations.ts",
    "prepack": "bun scripts/build.ts && bun scripts/build-declarations.ts",
    "test": "bun test --check --parallel --timings=bun-timings.json",
    "test:serial": "bun test --check",
    "test:timings": "rm -f bun-timings.json && bun test --check --parallel --timings=bun-timings.json --update-timings",
    "check": "bun check && bun check -p app && bun check -p __tests__/jobs/app/pkg",
    "gen:client": "bun-client generate --module scripts/jobs/routes-openapi.ts --out app/jobs/api/routes.gen.ts",
    "check:client": "bun-client generate --module scripts/jobs/routes-openapi.ts --out app/jobs/api/routes.gen.ts --check",
    "lint": "bun lint",
    "format": "bun fmt",
    "format:check": "bun fmt --check"
  },
  "peerDependencies": {
    "@kingsleyweb/bun-jobs": "workspace:^",
    "@types/bun": ">=1.4.2"
  },
  "peerDependenciesMeta": {
    "@kingsleyweb/bun-jobs": {
      "optional": true
    },
    "@types/bun": {
      "optional": true
    }
  },
  "dependencies": {
    "@kingsleyweb/bun-common": "workspace:^"
  },
  "devDependencies": {
    "@happy-dom/global-registrator": "catalog:",
    "@kingsleyweb/bun-client": "workspace:^",
    "@kingsleyweb/bun-jobs": "workspace:^",
    "@kingsleyweb/bun-nest": "workspace:^",
    "@nestjs/common": "catalog:",
    "@nestjs/core": "catalog:",
    "@tanstack/react-query": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@types/bun": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "bun-types": "catalog:",
    "happy-dom": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "reflect-metadata": "catalog:",
    "rxjs": "catalog:",
    "typescript": "catalog:"
  }
}
