        "JobsUiAuthorizeResult",
        "JobsUiUnauthorizedOptions",
        "UiUnauthorized",
        "UiUnauthorizedStatus",
        "UiConfig",
        "UiSections",
        "UiTheme"
      ],
      "snippet": "const ui = m.jobsUi({ apiUrl: \"/jobs-api\", basePath: \"/jobs\" });\nexport type _ui = Expect<IsAny<typeof ui>>;\nexport type _router = Expect<IsAny<typeof ui.router>>;\nconst _basePath: Equal<typeof ui.basePath, string> = true;\nexport type _api = Expect<IsAny<t.JobsUiApiOptions[\"api\"]>>;"
    },
