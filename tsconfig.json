{
  // Root config consulted by tooling that resolves a tsconfig from the repo
  // root (e.g. `bun test` run from the monorepo root, which transpiles files
  // across packages in one process). The per-package configs remain the source
  // of truth for type-checking each package; this extends the same base so a
  // file transpiled from the root is read the same way it is read from its own
  // package — the decorator options NestJS needs among them.
  "extends": "./tsconfig.base.json",
  "include": []
}
